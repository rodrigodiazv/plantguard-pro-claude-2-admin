{
  "buildCommand": "npm run build || echo 'No build needed'",
  "framework": "other",
  "functions": {
    "api/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "public": "public",
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/", "destination": "/index.html" },
    { "source": "/", "destination": "/login.html" }
  ]
}
